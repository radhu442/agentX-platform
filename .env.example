# AgentX Platform — Environment Variables
# Copy this file to .env and fill in your values.
# The app works without any of these (uses safe defaults).

# Flask secret key (leave blank to auto-generate a secure key each restart)
# SECRET_KEY=your-very-long-random-secret-here

# ─── AI Provider (optional) ──────────────────────────────────────────────────
# Set ONE of these to enable real AI in the Agent Simulator.
# If neither is set, a smart rule-based fallback is used automatically.

# Google Gemini  (recommended — free tier available)
# GEMINI_API_KEY=AIza...

# OpenAI
# OPENAI_API_KEY=sk-...
